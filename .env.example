# Copier en .env et remplir. Ne jamais committer .env.
# Pas de commentaire en fin de ligne : docker --env-file les prendrait dans la valeur.

# Obligatoire. Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-avec-un-token-long-et-aleatoire

# Optionnels (décommenter pour changer le défaut)
# MODEL_BACKEND=onnx
# ONNX_MODEL_PATH=models/onnx/resnet50-int8-static.onnx
# ONNX_MODELS_DIR=models/onnx
# DEFAULT_MODEL_ID=resnet50-onnx-int8
# ENABLED_MODELS=resnet50-onnx-int8
# HF_MODEL_ALLOWLIST=
# AZURE_RUNTIME=false
# CONFIDENCE_THRESHOLD=0.6
# MAX_UPLOAD_MB=5
# RATE_LIMIT_PER_MINUTE=60
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MIN_IMAGE_SIDE=64
# MIN_IMAGE_STD=8.0
# HF_TOKEN=
# MLFLOW_TRACKING_URI=http://localhost:5000
