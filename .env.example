# Copier en .env et remplir. Ne jamais committer .env.
# Pas de commentaire en fin de ligne : docker --env-file les prendrait dans la valeur.

# Obligatoire. Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-avec-un-token-long-et-aleatoire

# Optionnels (décommenter pour changer le défaut)
